# ========================================================
# Thalir Boutique - Production Environment Variables
# ========================================================

# Django Security
SECRET_KEY=your-django-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=thalirboutique.com,www.thalirboutique.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL in production)
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://thalir_user:thalir_secure_password@localhost:5432/thalir_db

# Razorpay Payment Gateway (Test or Live Credentials)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Fast2SMS Carrier Gateway (For SMS broadcasts & COD OTP verification)
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here

# Meta WhatsApp Cloud API (For automated order confirmations & tracking alerts)
WHATSAPP_API_TOKEN=EAA...your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=1092837465...
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321...

# Cloudinary CDN Storage (For compressed WebP product image hosting)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Google OAuth (For One-Tap Google Login)
VITE_GOOGLE_CLIENT_ID=669324300059-p91pg38jbrrcveb5uo200s7v6md4qhgi.apps.googleusercontent.com
